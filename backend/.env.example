STOCKSMART_DATABASE_URL=postgresql+psycopg://stocksmart:change-me@localhost:5432/stocksmart
STOCKSMART_TEST_DATABASE_URL=postgresql+psycopg://stocksmart:change-me@localhost:5432/stocksmart_test
STOCKSMART_CORS_ORIGINS=http://localhost:5173,https://stocksmart-nine.vercel.app
STOCKSMART_ENVIRONMENT=development
# Required: generate a unique random value with secrets.token_urlsafe(48).
STOCKSMART_JWT_SECRET=
STOCKSMART_JWT_TTL_MINUTES=30
STOCKSMART_DB_CONNECT_TIMEOUT=3
# Optional private local evidence root; commercial evidence persists in PostgreSQL.
# STOCKSMART_PRICE_EVIDENCE_DIR=
# Production backups: bucket must block public access.
# STOCKSMART_BACKUP_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-west-2
# STOCKSMART_BACKUP_ENDPOINT=
# STOCKSMART_PG_BIN=
